
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="QUẢN LÝ CHI TIÊU"
            android:textColor="#173B72"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nhập thông tin khoản chi của bạn"
            android:textColor="#666666"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginBottom="28dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tên khoản chi"
            android:textColor="#222222"
            android:textStyle="bold"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/edtTenKhoanChi_105"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ví dụ: Ăn sáng"
            android:inputType="textCapSentences"
            android:singleLine="true"
            android:padding="14dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="18dp"
            android:backgroundTint="#2864B4" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Số tiền (VNĐ)"
            android:textColor="#222222"
            android:textStyle="bold"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/edtSoTien_105"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ví dụ: 25000"
            android:inputType="numberDecimal"
            android:singleLine="true"
            android:padding="14dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="18dp"
            android:backgroundTint="#2864B4" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ghi chú"
            android:textColor="#222222"
            android:textStyle="bold"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/edtGhiChu_105"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhập ghi chú (không bắt buộc)"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="2"
            android:gravity="top|start"
            android:padding="14dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="26dp"
            android:backgroundTint="#2864B4" />

        <Button
            android:id="@+id/btnThemKhoanChi_105"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thêm khoản chi"
            android:textAllCaps="false"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnXemChiTiet_105"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Xem chi tiết khoản chi"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>
